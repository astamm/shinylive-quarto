# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.obsidian/

# ---------------------------------------------------------------------------
# R / renv (renv.lock and renv/activate.R stay versioned)
# ---------------------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
.Renviron
renv/library/
renv/local/
renv/cellar/
renv/.renvignore
renv/python/

# ---------------------------------------------------------------------------
# Quarto project internals & build output (generated by quarto render)
# ---------------------------------------------------------------------------
.quarto/
_quarto/
_freeze/
_cache/
_publish/
_rsconnect/
site/_site/
site/build/

# ---------------------------------------------------------------------------
# Rendered documents (quarto render output).
# NOTE: slides/resources/slidecrafting/*.html are SOURCE (the include-after-body
# scripts) and slides/_extensions/ is versioned, so *.html is NOT blanked.
# Individual generated HTML + their *_files/ sidecars are ignored instead.
# ---------------------------------------------------------------------------
# --- deck ---
slides/slides.html
slides/slides_files/
slides/examples/hello.html
slides/examples/hello_files/
slides/examples/report.html
slides/examples/report_files/
# --- labs (rendered docs; *.qmd are source) ---
labs/lab-*.html
labs/lab-*_files/
# --- standalone examples / example report ---
examples/hello.html
examples/hello_files/
example-report/report.html
example-report/report_files/

# logs
*.log
